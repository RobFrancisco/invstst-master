      "description": "ID of the sold product"
    },
    "product_name": {
      "type": "string",
      "description": "Name of the sold product"
    },
    "product_category": {
      "type": "string",
      "description": "Category of the sold product"
    },
    "quantity": {
      "type": "number",
      "description": "Quantity sold"
    },
    "unit_price": {
      "type": "number",
      "description": "Selling price per unit"
    },
    "cost_price": {
      "type": "number",
      "description": "Cost price per unit"
    },
    "total": {
      "type": "number",
      "description": "Total sale amount"
    },
    "profit": {
      "type": "number",
      "description": "Profit from this sale"
    },
    "customer_name": {
      "type": "string",
